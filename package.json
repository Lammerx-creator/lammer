{
  "name": "deutschtrainer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "dev:web": "npm run prepare:pdf && vite --host 0.0.0.0",
    "dev:api": "node --watch server/server.mjs",
    "start:api": "node server/server.mjs",
    "start": "node server/production.mjs",
    "prepare:pdf": "node scripts/pdf-assets.mjs",
    "dev:server": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "test:backend": "vitest run server",
    "test:e2e": "playwright test",
    "publish:pages": "node scripts/publish-pages.mjs"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "fake-indexeddb": "^6.1.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  }
}
